{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron-autopilot",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/cron-autopilot", "destination": "/api/cron?job=vercel-autopilot" },
    { "source": "/radar-mundial", "destination": "/radar-mundial.html" },
    { "source": "/mundial", "destination": "/mundial.html" },
    { "source": "/entretenimento", "destination": "/entretenimento.html" },
    { "source": "/transportes", "destination": "/transportes.html" },
    { "source": "/us/new-york", "destination": "/us/new-york.html" },
    { "source": "/fr/paris", "destination": "/fr/paris.html" },
    { "source": "/fr/lyon", "destination": "/fr/lyon.html" },
    { "source": "/fr/saint-etienne", "destination": "/fr/saint-etienne.html" },
    { "source": "/jp/tokyo", "destination": "/jp/tokyo.html" },
    { "source": "/pt/lisbon", "destination": "/pt/lisbon.html" },
    { "source": "/it/rome", "destination": "/it/rome.html" },
    { "source": "/es/barcelona", "destination": "/es/barcelona.html" },
    { "source": "/ar/buenos-aires", "destination": "/ar/buenos-aires.html" },
    { "source": "/nl/amsterdam", "destination": "/nl/amsterdam.html" }
  ]
}
